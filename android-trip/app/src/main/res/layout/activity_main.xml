<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/trip_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:padding="10dp">

    <RelativeLayout
        android:id="@+id/trip_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

    <TextView
        android:id="@+id/privacy_link"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_marginTop="6dp"
        android:clickable="true"
        android:focusable="true"
        android:minHeight="48dp"
        android:gravity="top|center_horizontal"
        android:text="@string/privacy_policy"
        android:textColor="#5AC8FA"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/status_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_toEndOf="@id/privacy_link"
        android:layout_toStartOf="@id/units_control"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:ellipsize="end"
        android:singleLine="true"
        android:text="Ready"
        android:textColor="@android:color/white"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/satellite_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/status_text"
        android:layout_alignStart="@id/status_text"
        android:layout_alignEnd="@id/status_text"
        android:gravity="center"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="@string/gnss_inactive"
        android:textColor="#B5C4D0"
        android:textSize="11sp" />

    <LinearLayout
        android:id="@+id/units_control"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="6dp"
        android:minWidth="80dp"
        android:minHeight="48dp"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="top|center_horizontal"
        android:orientation="vertical">

    <TextView
        android:id="@+id/units_toggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/units_metric_short"
        android:textColor="#5AC8FA"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/date_moon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:textColor="@android:color/white"
        android:textSize="12sp" />
    </LinearLayout>
    </RelativeLayout>

    <LinearLayout
        android:id="@+id/trip_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/trip_header"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.ottospo.tripcompanion.CompassView
            android:id="@+id/compass_view"
            android:layout_width="120dp"
            android:layout_height="120dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="8dp">

            <TextView
                android:id="@+id/distance_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:text="--"
                android:textColor="@android:color/white"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/bearing_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="--"
                android:textColor="#35C759"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/course_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="Course: --"
                android:textColor="#E02020"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/extra_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="Alt: --  Path: 0 m"
                android:textColor="@android:color/white"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/elapsed_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="Elapsed: 00h:00m:00sec"
                android:textColor="@android:color/white"
                android:textSize="14sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/book_link"
            android:layout_width="64dp"
            android:layout_height="100dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="10dp"
            android:background="?android:attr/selectableItemBackground"
            android:contentDescription="@string/book_link_description"
            android:scaleType="fitCenter"
            android:src="@drawable/book_cover" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/trip_controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/trip_summary"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="8dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <Button
            android:id="@+id/start_stop_button"
            android:layout_width="100dp"
            android:layout_height="50dp"
            android:text="START"
            android:textSize="16sp" />

        <Button
            android:id="@+id/photo_button"
            android:layout_width="120dp"
            android:layout_height="50dp"
            android:drawableStart="@drawable/ic_camera"
            android:drawablePadding="4dp"
            android:enabled="false"
            android:contentDescription="@string/photo_description"
            android:text="@string/photo"
            android:textSize="16sp" />

        <Button
            android:id="@+id/transport_button"
            android:layout_width="72dp"
            android:layout_height="50dp"
            android:contentDescription="@string/transport_mode_title"
            android:text="@string/transport_walk"
            android:textSize="18sp" />
    </LinearLayout>

    <RelativeLayout
        android:id="@+id/trail_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/trip_controls"
        android:layout_alignStart="@id/trip_controls"
        android:layout_alignEnd="@id/trip_controls"
        android:layout_marginTop="6dp">

        <Button
            android:id="@+id/share_trail_button"
            android:layout_width="72dp"
            android:layout_height="50dp"
            android:layout_alignParentEnd="true"
            android:text="@string/share_trail"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/trail_caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_toStartOf="@id/share_trail_button"
            android:minHeight="50dp"
            android:gravity="center"
            android:text="Trail"
            android:textColor="@android:color/white"
            android:textSize="14sp" />
    </RelativeLayout>

    <com.ottospo.tripcompanion.TrailView
        android:id="@+id/trail_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/trail_header"
        android:layout_alignParentBottom="true"
        android:layout_marginTop="6dp">
    </com.ottospo.tripcompanion.TrailView>
</RelativeLayout>
