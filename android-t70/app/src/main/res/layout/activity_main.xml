<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:padding="10dp">

    <TextView
        android:id="@+id/stats_names"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:text="Hits/set:\nTotal hits:\nMax hits/set:"
        android:textColor="@android:color/white"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/stats_values"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_marginStart="8dp"
        android:layout_toEndOf="@id/stats_names"
        android:gravity="end"
        android:text="0\n0\n0"
        android:textColor="@android:color/white"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/elapsed_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/stats_names"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="16dp"
        android:text="Elapsed: 00h:00m:00sec"
        android:textColor="@android:color/white"
        android:textSize="14sp" />

    <Button
        android:id="@+id/start_stop_button"
        android:layout_width="120dp"
        android:layout_height="50dp"
        android:layout_below="@id/elapsed_time"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="8dp"
        android:text="START"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/sensitivity_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/start_stop_button"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="10dp"
        android:text="Hit threshold: 3.0"
        android:textColor="@android:color/white"
        android:textSize="12sp" />

    <SeekBar
        android:id="@+id/sensitivity_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/sensitivity_text"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="4dp" />

    <com.ottospo.badmintonwatch.BatteryView
        android:id="@+id/battery_view"
        android:layout_width="34dp"
        android:layout_height="16dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true" />
</RelativeLayout>
